                        <buildArg>-H:ConfigurationFileDirectories=src/main/resources/META-INF/native-image/</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>-->
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>regular</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
